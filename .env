# ==========================================================
# CONFIGURACIÓN DEL BACKEND LORAWAN MONITOR
# ==========================================================
APP_ENV=development
DEMO_MODE=false

# Base de datos PostgreSQL para LoRaWAN Monitor
# Puerto 5433 en host para no colisionar con otros contenedores postgres
POSTGRES_USER=lorawan_admin
POSTGRES_PASSWORD=lorawan_secret_2026
POSTGRES_DB=lorawan_monitor
DATABASE_URL=postgresql+asyncpg://lorawan_admin:lorawan_secret_2026@localhost:5433/lorawan_monitor

# Seguridad JWT del Backend (Autenticación móvil)
JWT_SECRET_KEY=lorawan_super_secret_jwt_key_development_2026_secure_random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==========================================================
# CONEXIÓN CON TU CHIRPSTACK v4 EXISTENTE (chirpstack-docker-master)
# ==========================================================
# Para ejecución local directa (uvicorn): usa localhost
# Para ejecución con Docker Compose: usa host.docker.internal o chirpstack-rest-api
CHIRPSTACK_API_URL=http://localhost:8090
CHIRPSTACK_MQTT_HOST=localhost
CHIRPSTACK_MQTT_PORT=1883
CHIRPSTACK_MQTT_USER=
CHIRPSTACK_MQTT_PASSWORD=
CHIRPSTACK_VERIFY_SSL=false

# Genera tu API Key en: http://localhost:8080 -> API Keys -> Add API key
# Pega aquí el token generado (debe tener permisos de lectura sobre Tenants, Devices, etc.)
CHIRPSTACK_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJjaGlycHN0YWNrIiwic3ViIjoiMzJlN2M4NjgtOTU2ZS00MGFhLWIxM2MtYjYyMDRmNTMyYTdlIiwiYXVkIjoiY2hpcnBzdGFjayIsImp0aSI6IjMyZTdjODY4LTk1NmUtNDBhYS1iMTNjLWI2MjA0ZjUzMmE3ZSIsInR5cCI6ImtleSJ9.b9jsiRXpueWQW84y5kvYjY88aeWFeC143Wcw7YH_YUk

# Umbrales operativos de conectividad
DEFAULT_NODE_SILENT_MINUTES=30
DEFAULT_GATEWAY_SILENT_MINUTES=15
DEFAULT_LOW_BATTERY_PERCENT=20
SYNC_INTERVAL_SECONDS=60

# Notificaciones Push
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=
EXPO_ACCESS_TOKEN=
