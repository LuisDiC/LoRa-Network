# ==========================================================
# CONFIGURACIÓN DEL BACKEND LORAWAN MONITOR (.env.example)
# ==========================================================
APP_ENV=production
DEMO_MODE=false

# Base de datos PostgreSQL para LoRaWAN Monitor
POSTGRES_USER=lorawan_admin
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA_SEGURA
POSTGRES_DB=lorawan_monitor
DATABASE_URL=postgresql+asyncpg://lorawan_admin:CAMBIAR_ESTA_CONTRASENA_SEGURA@monitor-db:5432/lorawan_monitor

# Seguridad JWT del Backend (Autenticación móvil)
# Genera una clave aleatoria segura para producción (ej: openssl rand -hex 32)
JWT_SECRET_KEY=CAMBIAR_ESTA_CLAVE_JWT_SUPER_SECRETA_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==========================================================
# CONEXIÓN CON CHIRPSTACK v4
# ==========================================================
CHIRPSTACK_API_URL=http://chirpstack-rest-api:8090
CHIRPSTACK_MQTT_HOST=mosquitto
CHIRPSTACK_MQTT_PORT=1883
CHIRPSTACK_MQTT_USER=
CHIRPSTACK_MQTT_PASSWORD=
CHIRPSTACK_VERIFY_SSL=false

# Genera tu API Key en la interfaz de ChirpStack:
# http://<IP-SERVIDOR>:8080 -> API keys -> Add API key
# y pega aquí el token generado:
CHIRPSTACK_API_TOKEN=PEGA_AQUI_TU_CHIRPSTACK_API_TOKEN

# Umbrales operativos de conectividad
DEFAULT_NODE_SILENT_MINUTES=30
DEFAULT_GATEWAY_SILENT_MINUTES=15
DEFAULT_LOW_BATTERY_PERCENT=20
SYNC_INTERVAL_SECONDS=60

# Notificaciones Push (Opcional)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=
EXPO_ACCESS_TOKEN=
